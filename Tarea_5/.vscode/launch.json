{
    "version": "0.2.0",
    "configurations": [
        {
            "name":"gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/debug/exec",
            "stopAtEntry": true,
            "cwd":"${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description":"Enable Pretty-printing for gdb",
                    "text":"-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description":"Add source directories for asm files",
                    "text":"-environment-directory ${workspaceFolder}/src",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug"
        }
    ]
}